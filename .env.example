# Telegram
TELEGRAM_BOT_TOKEN=

# Model (Groq, OpenAI-compatible endpoint)
MODEL_NAME=openai/gpt-oss-120b
CLOUD_ENDPOINT=https://api.groq.com/openai/v1
OPENAI_API_KEY=
MODEL_MAX_TOKENS=1200

# Tavily web search
TAVILY_API_KEY=

# Runtime
TZ=Asia/Kolkata

# LangSmith tracing (turn on after adding the key)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sanje-simple

# Metadata only. LangSmith treats LANGSMITH_AGENT_ID/ENVIRONMENT as a beta
# trace destination, which conflicts with LANGSMITH_PROJECT, so use these.
SANJE_AGENT_ID=sanje-simple
SANJE_AGENT_ENVIRONMENT=local

# Not used by this build: the model is Groq / openai-compatible.
# ANTHROPIC_API_KEY=
